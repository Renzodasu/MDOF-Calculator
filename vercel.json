{
  "headers": [
    {
      "source": "/(og|icon-180|icon-192|icon-512)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=604800"
        }
      ]
    },
    {
      "source": "/(mdof_solver\\.py|mdof_eigen\\.c)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/three.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
